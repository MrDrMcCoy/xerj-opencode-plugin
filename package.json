{
  "name": "@mrdrmccoy/xerj-opencode-plugin",
  "version": "0.4.2",
  "description": "XERJ integration for OpenCode: local code and docs search, agent memory, and retrieval accounting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrDrMcCoy/xerj-opencode-plugin.git"
  },
  "homepage": "https://github.com/MrDrMcCoy/xerj-opencode-plugin#readme",
  "bugs": {
    "url": "https://github.com/MrDrMcCoy/xerj-opencode-plugin/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "search",
    "xerj",
    "rag",
    "code-search"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "src",
    "dist",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "build:tui": "bun build src/tui.tsx --outdir dist --target bun --packages external --production",
    "prepack": "bun run build:tui"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.5",
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.10.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.7.0",
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "solid-js": "^1.9.17"
  }
}
